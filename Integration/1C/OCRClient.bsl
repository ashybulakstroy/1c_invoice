// Серверный пример транспорта. Не создаёт и не проводит документы 1С.
// Ключ хранить в защищённых серверных настройках, не в клиентском модуле.
// API 1.1: request_id относится к открытой форме, document_uuid появляется после записи.
// Сервер принимает только контракт 1.1; устаревший контракт 1.0
// (base_id/invoice_uuid, статус "imported") удалён.

Функция ЗапросOCR(Хост, Порт, КлючAPI, Метод, Путь, Данные = Неопределено) Экспорт
    Соединение = Новый HTTPСоединение(Хост, Порт, , , , 20);
    Запрос = Новый HTTPЗапрос(Путь);
    Запрос.Заголовки.Вставить("X-API-Key", КлючAPI);
    Запрос.Заголовки.Вставить("Accept", "application/json");
    Если Данные <> Неопределено Тогда
        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        ЗаписатьJSON(Запись, Данные);
        Тело = Запись.Закрыть();
        Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8,
            ИспользованиеByteOrderMark.НеИспользовать);
    КонецЕсли;
    Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
    Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
    Если Ответ.КодСостояния >= 400 Тогда
        ВызватьИсключение СтрШаблон("OCR HTTP %1: %2", Ответ.КодСостояния, Текст);
    КонецЕсли;
    Результат = Неопределено;
    Если НЕ ПустаяСтрока(Текст) Тогда
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Текст);
        Результат = ПрочитатьJSON(Чтение, Истина);
        Чтение.Закрыть();
    КонецЕсли;
    Возврат Новый Структура("Код,Данные", Ответ.КодСостояния, Результат);
КонецФункции

Функция ТотЖеИдентификатор(Значение, Ожидаемое)
    // Сравнение без учёта регистра и внешних пробелов; безопасно к Null и числам.
    Возврат НРег(СокрЛП(Строка(Значение))) = НРег(СокрЛП(Строка(Ожидаемое)));
КонецФункции

Функция СоздатьЗапускOCR(Хост, Порт, КлючAPI, ИДБазы, ИДЗапуска, UUIDДокумента = Неопределено) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("database_id", Строка(ИДБазы));
    Данные.Вставить("request_id", Строка(ИДЗапуска));
    Если ЗначениеЗаполнено(UUIDДокумента) Тогда
        Данные.Вставить("document_uuid", Строка(UUIDДокумента));
    КонецЕсли;
    // ИДЗапуска создаётся один раз и сохраняется в реквизите формы ДО сетевого вызова.
    // Повтор после тайм-аута использует тот же ИДЗапуска. Документ не записывать.
    Возврат ЗапросOCR(Хост, Порт, КлючAPI, "POST", "/tasks", Данные);
КонецФункции

Функция ПолучитьРезультатЗапускаOCR(Хост, Порт, КлючAPI, ИДЗадания, ИДБазы, ИДЗапуска) Экспорт
    Путь = "/tasks/" + Строка(ИДЗадания) + "/result?database_id="
        + КодироватьСтроку(Строка(ИДБазы), СпособКодированияСтроки.КодировкаURL)
        + "&request_id="
        + КодироватьСтроку(Строка(ИДЗапуска), СпособКодированияСтроки.КодировкаURL);
    Ответ = ЗапросOCR(Хост, Порт, КлючAPI, "GET", Путь);
    Если Ответ.Данные = Неопределено Тогда
        ВызватьИсключение "OCR вернул пустой ответ результата";
    КонецЕсли;
    Если НЕ ТотЖеИдентификатор(Ответ.Данные.Получить("database_id"), ИДБазы)
        Или НЕ ТотЖеИдентификатор(Ответ.Данные.Получить("request_id"), ИДЗапуска) Тогда
        ВызватьИсключение "Результат OCR относится к другой базе или форме счёта";
    КонецЕсли;
    // При 202 не менять форму. При 200 сначала проверить ВСЕ строки и решения о дефиците.
    // Эта функция не записывает и не проводит документ, не отправляет квитанцию.
    Возврат Ответ;
КонецФункции

Функция СвязатьЗаписанныйДокументOCR(Хост, Порт, КлючAPI, ИДЗадания, ИДБазы, ИДЗапуска, UUIDДокумента) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("database_id", Строка(ИДБазы));
    Данные.Вставить("request_id", Строка(ИДЗапуска));
    Данные.Вставить("document_uuid", Строка(UUIDДокумента));
    // После записи пустого счёта сохраняет только связь, не статус applied.
    Возврат ЗапросOCR(Хост, Порт, КлючAPI, "POST", "/tasks/" + Строка(ИДЗадания) + "/document-link", Данные);
КонецФункции

Функция УведомитьПрименениеOCR(Хост, Порт, КлючAPI, ИДЗадания, ИДБазы, ИДЗапуска,
    UUIDДокумента, ИДОперации, Версия, Хеш, НомерСчета, ПредупрежденияОстатков = Неопределено) Экспорт
    Данные = Новый Структура;
    Данные.Вставить("database_id", Строка(ИДБазы));
    Данные.Вставить("request_id", Строка(ИДЗапуска));
    Данные.Вставить("document_uuid", Строка(UUIDДокумента));
    Данные.Вставить("operation_id", Строка(ИДОперации));
    // Сервер принимает только целое число версии.
    Данные.Вставить("result_version", Число(Версия));
    Данные.Вставить("checksum", Строка(Хеш));
    Данные.Вставить("status", "applied");
    Данные.Вставить("document_number", Строка(НомерСчета));
    Если ПредупрежденияОстатков <> Неопределено Тогда
        Данные.Вставить("stock_warnings", ПредупрежденияОстатков);
    КонецЕсли;
    // Вызывать после успешной штатной записи, не после заполнения формы.
    // ИДОперации/версию/хеш хранить в 1С; при потере ответа повторять ту же квитанцию.
    // При обычной записи счёта НЕ вызывать повторную проверку остатков.
    Возврат ЗапросOCR(Хост, Порт, КлючAPI, "POST", "/tasks/" + Строка(ИДЗадания) + "/import-receipt", Данные);
КонецФункции

Функция ПолучитьРезультатOCR(Хост, Порт, КлючAPI, ИДЗадания) Экспорт
    Ответ = ЗапросOCR(Хост, Порт, КлючAPI, "GET", "/tasks/" + Строка(ИДЗадания) + "/result");
    // Код 202 означает: оператор ещё не подтвердил результат. Счёт не заполнять.
    Возврат Ответ;
КонецФункции
