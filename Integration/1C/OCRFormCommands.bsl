// Шаблон клиентского общего модуля расширения. Не готовый файл .cfe.
// Реальные имена табличных частей и события формы настраиваются в целевом релизе.

Функция СостояниеКомандOCR(КоличествоТоваров, КоличествоУслуг, ИДЗадания) Экспорт
    ПустойСчет = КоличествоТоваров = 0 И КоличествоУслуг = 0;
    Возврат Новый Структура("Видимость,ОбработатьФотоДоступна,ПолучитьРезультатДоступна",
        ПустойСчет, ПустойСчет, ПустойСчет И ЗначениеЗаполнено(ИДЗадания));
КонецФункции

Процедура ПроверитьПустойСчетOCR(КоличествоТоваров, КоличествоУслуг) Экспорт
    Если КоличествоТоваров <> 0 Или КоличествоУслуг <> 0 Тогда
        ВызватьИсключение "В счёте уже есть строки товаров или услуг. Импорт OCR не выполнен.";
    КонецЕсли;
КонецПроцедуры

Процедура ОбновитьКомандыOCR(Форма, КоличествоТоваров, КоличествоУслуг, ИДЗадания) Экспорт
    Состояние = СостояниеКомандOCR(КоличествоТоваров, КоличествоУслуг, ИДЗадания);
    Фото = Форма.Элементы.Найти("OCRОбработатьФото");
    Результат = Форма.Элементы.Найти("OCRПолучитьРезультат");
    Если Фото = Неопределено Или Результат = Неопределено Тогда
        ВызватьИсключение "Добавьте команды OCR в основную форму счёта через расширение";
    КонецЕсли;
    Фото.Видимость = Состояние.Видимость;
    Фото.Доступность = Состояние.ОбработатьФотоДоступна;
    Результат.Видимость = Состояние.Видимость;
    Результат.Доступность = Состояние.ПолучитьРезультатДоступна;
    Группа = Форма.Элементы.Найти("OCRГруппаКоманд");
    Если Группа <> Неопределено Тогда
        Группа.Видимость = Состояние.Видимость;
    КонецЕсли;
КонецПроцедуры

Функция НужноЗаполнятьПоВерсииOCR(ОтветHTTP, ПримененнаяВерсияВФорме) Экспорт
    Если ОтветHTTP.Код = 202 Тогда
        Возврат Ложь;
    КонецЕсли;
    Если ОтветHTTP.Код <> 200 Тогда
        ВызватьИсключение "Нет подтверждённого результата OCR";
    КонецЕсли;
    Если ОтветHTTP.Данные = Неопределено Тогда
        ВызватьИсключение "OCR вернул пустой ответ результата";
    КонецЕсли;
    Если ОтветHTTP.Данные.Получить("status") <> "confirmed" Тогда
        ВызватьИсключение "Нет подтверждённого результата OCR";
    КонецЕсли;
    // Версия приходит числом; в форме она может храниться строкой.
    ВерсияРезультата = Число(ОтветHTTP.Данные.Получить("result_version"));
    Если ЗначениеЗаполнено(ПримененнаяВерсияВФорме) Тогда
        Если ВерсияРезультата = Число(ПримененнаяВерсияВФорме) Тогда
            Возврат Ложь;
        КонецЕсли;
        ВызватьИсключение "В форме уже использована другая версия. Нужна явная сверка, не добавление строк.";
    КонецЕсли;
    Возврат Истина;
КонецФункции
